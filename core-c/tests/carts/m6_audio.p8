pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init() music(0) end
t=0
function _update()
 t+=1
 if t==3 then sfx(2,3) end            -- one-shot lead on channel 3
 if t%4==0 then
  printh("f"..t.." s16,17,18,19="..stat(16)..","..stat(17)..","..stat(18)..","..stat(19)
    .." n20="..stat(20).." pat="..stat(24))
 end
end
