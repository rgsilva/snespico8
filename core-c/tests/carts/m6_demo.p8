pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- snespico8 audio demo (M6): the SPC plays this in real time while the
-- 65816 game loop crawls. Music = real time; video updates slowly.
t=0
function _init() music(0) end
function _update() t+=1 end
function _draw()
 cls(1)
 print("snespico8 audio",22,34,7)
 print("music: real-time spc",14,48,12)
 print("video: slow-mo cpu",18,56,8)
 rectfill(20,72,20+(t%88),76,11)
 circfill(64,98,4+(t%6),10)
 print("frame "..t,46,112,6)
end
